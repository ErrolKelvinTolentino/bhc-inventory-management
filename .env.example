SUPABASE_URL=https://hmapfyndwrvsapllythc.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only; used exclusively by shared session storage. Required on Vercel.
SUPABASE_SECRET_KEY=
# sqlite for local development; supabase for shared/serverless sessions.
SESSION_BACKEND=sqlite
# Generate a long random value for a deployed server. Local development creates
# and persists a private key in the ignored instance/ directory automatically.
SECRET_KEY=
APP_TIMEZONE=Asia/Manila
PORT=5000
# Leave empty locally to use the request origin. Set the canonical HTTPS URL
# before deployment, and allow its /auth/callback/** URLs in Supabase Auth.
APP_URL=
# Set to 1 only behind HTTPS in deployment.
COOKIE_SECURE=0
